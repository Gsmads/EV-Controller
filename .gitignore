# Build artifacts
*.o
*.obj
*.exe
*.out
*.elf
*.hex
*.bin

# Test binaries (no extension on Linux/Mac)
# Шаблоном, а не поимённо: имена в Makefile и здесь иначе разъезжаются, и
# четвёртый тест уходит в коммит собранным. Исходники исключены обратно.
tests/test_*
!tests/test_*.c
!tests/test_*.cpp
!tests/test_*.h

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Arduino build
build/
*.tmp

# Editor
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Рабочие копии агентов Claude Code
# Изолированные git-worktree, создаются на время параллельной работы и
# удаляются после. Внутри — второй чекаут этого же репозитория, включая
# собранные бинарники тестов: в историю попасть не должно.
.claude/worktrees/
